{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campusly",
  "main": "src/index.js",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campusly-db",
      "database_id": "522ffcc1-5b22-44eb-9761-300e2bc64b43",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
