{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campusly",
  "main": "src/index.js",
  "account_id": "1b6d355c4ca9a283dff5669a551350d7",
  "compatibility_date": "2026-10-26",
  "vars": {
    "ADMIN_USERNAME": "siteadmin"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campusly-db",
      "database_id": "522ffcc1-5b22-44eb-9761-300e2bc64b43",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
